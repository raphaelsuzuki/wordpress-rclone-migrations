# Flywheel Local to WordOps Migration Example
# Generated: Example configuration for Local development to WordOps production
# Database credentials are automatically extracted from wp-config.php files

[source]
wp_root=/Users/username/Local Sites/mysite/app/public
wp_content=/Users/username/Local Sites/mysite/app/public/wp-content
wp_config=/Users/username/Local Sites/mysite/app/public/wp-config.php

[destination]
ssh_host=mysite.com
ssh_user=root
ssh_key=/Users/username/.ssh/id_rsa
use_ssh_key=true
rclone_remote=wp-local-to-wordops
wp_root=/var/www/mysite.com/htdocs
wp_content=/var/www/mysite.com/htdocs/wp-content
wp_config=/var/www/mysite.com/wp-config.php

[urls]
source_url=https://mysite.local
destination_url=https://mysite.com

[options]
exclude=*.log,cache/*,node_modules/*,/.git/*,uploads/cache/*
sync_wp_config=false
fix_permissions=true
web_user=www-data
web_group=www-data
rclone_flags=--transfers=4 --checkers=8 --progress
last_sync=never

# Optional: Custom directory paths for non-standard setups
# Remove or comment out if using standard wp-content structure
[paths]
# Source (Flywheel Local) custom paths - using defaults in this example
# src_uploads_dir=/Users/username/Local Sites/mysite/app/public/wp-content/uploads
# src_plugins_dir=/Users/username/Local Sites/mysite/app/public/wp-content/plugins
# src_themes_dir=/Users/username/Local Sites/mysite/app/public/wp-content/themes

# Destination (WordOps) custom paths - using defaults in this example
# dest_uploads_dir=/var/www/mysite.com/htdocs/wp-content/uploads
# dest_plugins_dir=/var/www/mysite.com/htdocs/wp-content/plugins
# dest_themes_dir=/var/www/mysite.com/htdocs/wp-content/themes