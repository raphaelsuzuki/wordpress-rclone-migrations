# Example WordPress Migration Configuration
# Copy this file and modify for your setup
# Database credentials are automatically extracted from wp-config.php files

[source]
wp_root=/var/www/html
wp_content=/var/www/html/wp-content
wp_config=/var/www/html/wp-config.php

[destination]
ssh_host=production.example.com
ssh_user=deploy
ssh_key=/home/user/.ssh/id_rsa
rclone_remote=wp-example-a1b2c3d4
wp_root=/var/www/example.com/htdocs
wp_content=/var/www/example.com/htdocs/wp-content
wp_config=/var/www/example.com/wp-config.php

[urls]
source_url=https://example.dev
destination_url=https://example.com

[options]
exclude=*.log,cache/*,node_modules/*,/.git/*,uploads/cache/*
sync_wp_config=false
fix_permissions=true
web_user=www-data
web_group=www-data
rclone_flags=--transfers=4 --checkers=8 --progress
last_sync=never